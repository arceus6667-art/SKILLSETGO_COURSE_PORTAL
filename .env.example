# Default is a persistent LOCAL sandbox. Never enable sandbox on a public deployment.
APP_MODE=sandbox
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Live mode requires all of the following. Never prefix secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supply EITHER the private server API key OR the transaction-pooler database URL.
# This variable accepts a current sb_secret_... key or legacy service_role key.
# Never use the publishable key here; never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
GOOGLE_AUTH_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Generate a random 32+ character secret for signed credential verification.
CREDENTIAL_SECRET=
